# Argos bot - root env file
# Copy to .env and fill in your values.

# --- Mode ---
ENVIRONMENT_MODE=PAPER_TRADING

# --- Symbols ---
SYMBOL=BTC/USDT

# --- Exchange ---

# --- Exchange ID (binanceusdm = USDT-M Futures, binance = Spot) ---
EXCHANGE_ID=binanceusdm

# --- Exchange API (required for LIVE) ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- Binance Futures Demo (demo-fapi.binance.com) ---
BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# --- Execution thresholds (regime-aware Policy D) ---
# TRENDING >= 0.55, RANGING >= 0.62 (when unset)
EXECUTION_THRESHOLD_TRENDING=0.55
EXECUTION_THRESHOLD_RANGING=0.62

# --- Risk defaults ---
RISK_PCT=0.01
DRAWDOWN_PCT=0.05

# --- Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
