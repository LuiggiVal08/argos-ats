{
  "stream": "signals:trading",
  "description": "Trading signal emitted by analytics-engine after inference",
  "version": 1,
  "fields": {
    "signal_id":     { "type": "string", "required": true, "pattern": "^[0-9a-f-]{36}$", "description": "UUID v7" },
    "symbol":        { "type": "string", "required": true, "pattern": "^[A-Z0-9]+/[A-Z0-9]+$" },
    "action":        { "type": "string", "required": true, "enum": ["BUY", "SELL"], "description": "BUY or SELL (HOLD is not published)" },
    "confidence":    { "type": "number", "required": true, "min": 0, "max": 1, "description": "Model confidence 0.0–1.0" },
    "model_version": { "type": "string", "required": false, "description": "Model version identifier" },
    "regime":        { "type": "string", "required": false, "enum": ["TRENDING", "RANGING", "UNKNOWN"], "description": "Detected market regime at signal time" },
    "timestamp":     { "type": "integer", "required": true, "min": 0, "description": "Signal generation timestamp ms UTC" },
    "schema_version": { "type": "integer", "required": true, "const": 1 }
  }
}
